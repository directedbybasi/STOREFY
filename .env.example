# ==============================================================================
# STOREFY — Environment Variables Template
# ==============================================================================
# Copy this file to .env.development, .env.staging, or .env.production.
# NEVER commit real secret values to version control.
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application Public URLs
NEXT_PUBLIC_APP_URL=https://dev.storefy.shop
NEXT_PUBLIC_ROOT_DOMAIN=storefy.shop

# ------------------------------------------------------------------------------
# Hosted Supabase Configuration (Required from Phase 1)
# ------------------------------------------------------------------------------
# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Client Key (Public - Safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Hosted PostgreSQL Database Connection Strings
# ------------------------------------------------------------------------------
# Pooled Connection URL (Used at runtime via PgBouncer / Supavisor, typically port 6543)
# SERVER-ONLY - NEVER EXPOSE TO CLIENT
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection URL (Used for migrations and schema sync, typically port 5432)
# SERVER-ONLY - NEVER EXPOSE TO CLIENT
DIRECT_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Cryptographic Secrets (SERVER-ONLY)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal string for AES-256-GCM credential vault
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
